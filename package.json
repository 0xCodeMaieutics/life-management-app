{
  "name": "life-management-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:prod": "next start --port 8082",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:prod": "tsx scripts/db-migrate.ts --prod",
    "db:reset": "tsx scripts/db-reset.ts && pnpm db:migrate",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:studio": "drizzle-kit studio",
    "telegram:session": "tsx scripts/telegram-session.ts",
    "codegen": "pnpm generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@base-ui/react": "^1.8.0",
    "@libsql/client": "^0.18.0",
    "@mistralai/mistralai": "^2.7.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.104.1",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.0.3",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "telegram": "^2.26.22",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tailwindcss": "^1.14.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.4.0"
}
